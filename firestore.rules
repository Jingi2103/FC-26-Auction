rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /auction/main {
      // Anyone can view the public auction board. Only the one admin email can change it.
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "jin.mj301@gmail.com";
    }
  }
}
